# Copia este archivo a apps/web/.env.local para desarrollo. Nunca se versiona.
# En Vercel, las marcadas como «sensitive» se crean con ese tipo (PLAN-SAAS §5).
#
# OJO: no hay base local ni de pruebas. En desarrollo, en Preview y en Production la
# app apunta al MISMO proyecto de Supabase, que es producción: todo lo que escribas
# desde tu equipo queda en la base real.

# --- Supabase (proyecto rbrntkztzijaxsnpgpqn, producción) -----------------------
NEXT_PUBLIC_SUPABASE_URL=https://rbrntkztzijaxsnpgpqn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# sensitive · solo src/server/supabase/service.ts
SUPABASE_SERVICE_ROLE_KEY=

# --- Capa SII -----------------------------------------------------------------
# sensitive · 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SII_TOKENS_KEY=
# sensitive · mismo valor que el secreto `cron_token` en Vault
CRON_SECRET=

# --- Sentry -------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
# Solo en el build (subida de source maps)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Prueba de Sentry de la Fase 0 (TEMPORAL: borrar al probar Sentry) -----------
# sensitive · Bearer de /api/spike/sentry. Sin esta variable la ruta responde 404.
SPIKE_TOKEN=
