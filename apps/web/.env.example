# Copia este archivo a apps/web/.env.local para desarrollo. Nunca se versiona.
# En Vercel, las marcadas como «sensitive» se crean con ese tipo (PLAN-SAAS §5).
#
# OJO: no hay base local ni de pruebas. En desarrollo y en Production (en Vercel solo
# se usa Production, no Preview) la app apunta al MISMO proyecto de Supabase, que es
# producción: todo lo que escribas desde tu equipo queda en la base real.

# --- Supabase (proyecto rbrntkztzijaxsnpgpqn, producción) -----------------------
NEXT_PUBLIC_SUPABASE_URL=https://rbrntkztzijaxsnpgpqn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# sensitive · solo src/server/supabase/service.ts
SUPABASE_SERVICE_ROLE_KEY=

# --- Capa SII -----------------------------------------------------------------
# sensitive · 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SII_TOKENS_KEY=
# sensitive · mismo valor que el secreto `cron_token` en Vault
CRON_SECRET=

# --- Correo (Resend) ----------------------------------------------------------
# Opcionales mientras no haya cuenta de Resend: sin ellas no se envían invitaciones
# por correo (src/server/env.ts → envCorreo() devuelve null).
# sensitive
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Timbre <no-responder@tudominio.cl>"
CORREO_REMITENTE=

# --- Turnstile (Cloudflare) ---------------------------------------------------
# Pública: widget en ingresar, crear cuenta, recuperar e invitación.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# sensitive · también va en Supabase Auth → Bot and abuse protection (PLAN-SAAS §4.7).
# Opcional en desarrollo: envTurnstile() devuelve null si falta.
TURNSTILE_SECRET_KEY=

# --- Sentry -------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
# Solo en el build (subida de source maps)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- App ----------------------------------------------------------------------
# Enlaces de los correos de Auth (${NEXT_PUBLIC_APP_URL}/auth/callback). En Supabase
# Auth → URL Configuration, agregar esa ruta a «Redirect URLs».
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Turnstile 
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=