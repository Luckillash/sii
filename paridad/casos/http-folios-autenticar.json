{
  "descripcion": "autenticar(): POST a CAutInicio.cgi con TLS mutuo (PEM con cadena), 302 con Set-Cookie (host-only, Domain, borrado y dominio ajeno) y página con document.cookie",
  "operacion": "httpFolios",
  "entrada": {
    "accion": "autenticar",
    "archivo": "cert-cadena.pem",
    "http": {
      "respuestas": [
        {
          "status": 302,
          "cabeceras": [
            [
              "Location",
              "/cgi_AUT2000/CAutValida.cgi?https://maullin.sii.cl/cvc_cgi/dte/of_solicita_folios"
            ],
            ["Set-Cookie", "s_aut=HOSTONLY01; path=/"],
            ["Set-Cookie", "NETSCAPE_LIVEWIRE.exp=EXPDEPRUEBA; Domain=.sii.cl; Path=/"],
            ["Set-Cookie", "VIEJA=borrar; Domain=.sii.cl; expires=Thu, 01 Jan 1970 00:00:00 GMT"],
            ["Set-Cookie", "AJENA=no; Domain=.example.com; Path=/"]
          ],
          "cuerpo": ""
        },
        {
          "status": 200,
          "cabeceras": [
            ["Content-Type", "text/html; charset=ISO-8859-1"],
            ["Set-Cookie", "NETSCAPE_LIVEWIRE.exp=EXPRENOVADA; Domain=sii.cl; Path=/"]
          ],
          "cuerpo": {
            "base64": ""
          }
        }
      ]
    }
  }
}
