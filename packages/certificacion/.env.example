# Copia este archivo a .env y complétalo. El .env NUNCA se versiona.

# Certificado digital del SII (.pfx) y su clave
SII_CERT_PATH=data/certs/mi-certificado.pfx
SII_CERT_PASS=

# Ruta al core PHP (solo para `pnpm paridad:generar`)
CERTIFICACION_CORE=../certificacion-core

# Validación en certificación (scripts/validar-certificacion.ts, PLAN §5.4).
# Solo ambiente de certificación (maullin / apicert / pangal).
SII_RUT_EMPRESA=
# Titular del certificado (quien envía)
SII_RUT_FIRMA=
EMISOR_RAZON_SOCIAL=
# Sin abreviaciones, según el SII
EMISOR_GIRO=
EMISOR_DIRECCION=
EMISOR_COMUNA=
# Resolución de certificación: número 0 y la fecha que entrega el SII
SII_FCH_RESOL=
SII_NRO_RESOL=0
# CAF de boletas (tipo 39) de certificación, con folios sin usar
SII_CAF_39=data/caf/caf-39.xml
# Primer folio a usar; se consume uno por caso del set, consecutivos
SII_FOLIO_INICIAL=
SII_SET_PRUEBAS=data/set_pruebas/Set Prueba BE.txt
# Secuencia del RCOF del día. El RCOF ya no es obligatorio desde el 2022-08-01
# (solo para períodos hasta julio de 2022); lo usan `sii certificacion enviar-rcof`
# y `scripts/validar-certificacion.ts --con-rcof`.
SII_RCOF_SEC_ENVIO=1

# Declaración de cumplimiento (sii certificacion descargar-set / declarar, y
# scripts/declaracion.ts descargar-set): correo del
# proveedor de software que se informa al descargar el set de pruebas.
SII_CORREO_PROVEEDOR=

# --- CLI (`pnpm sii ...` / binario `sii`, fase 7) ---------------------------------
# Las variables de arriba sirven también para la CLI. Las opciones de la línea de
# comandos (--caf, --folio-inicial, --fch-resol, ...) reemplazan a estas variables.

# Producción (`sii produccion emitir`): resolución de la empresa para la carátula y
# CAF de boletas de producción. Sin valores por defecto: son los de la autorización.
SII_PRODUCCION_NRO_RESOL=
SII_PRODUCCION_FCH_RESOL=
SII_PRODUCCION_CAF_39=
# Opcionales, solo para boletas exentas (tipo 41 en el --boleta): producción y certificación.
SII_PRODUCCION_CAF_41=
SII_CAF_41=

# Opcional: archivo JSON donde la CLI guarda los tokens vigentes entre ejecuciones
# (la carpeta debe existir). Guarda credenciales: no versionar ni compartir.
SII_CACHE_TOKENS=
