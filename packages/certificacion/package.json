{
  "name": "certificacion-node",
  "private": true,
  "description": "Port a Node.js/TypeScript de winex/certificacion (integraciÃ³n con el SII de Chile).",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "paridad:generar": "node paridad/http/generar.mjs",
    "paridad:xsd": "php paridad/php/validar-xsd.php",
    "humo:tls": "node scripts/humo-tls.ts",
    "sii": "node --conditions=source apps/cli/src/main.ts",
    "mcp": "node --conditions=source apps/cli/src/mcp-main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^24.0.0",
    "node-forge": "^1.4.3",
    "@types/node-forge": "^1.3.14",
    "typescript": "~6.0.3"
  }
}
